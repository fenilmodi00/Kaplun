# Cerebras Inference — Kimi K3.1 Pro (https://cloud.cerebras.ai)
# Paste the Cerebras API key here (same value as CEREBRAS_API_KEY in their SDK examples).
KIMI_API_KEY=
KIMI_BASE_URL=https://api.cerebras.ai/v1/
KIMI_MODEL=moonshotai-kimi-k3.1-pro-trial

# Optional overrides
# KIMI_MAX_TOKENS=64000
# KAPLUN_DB=data/kaplun.db

# Optional: dollars per million tokens, only used if Cerebras's model list can't be read.
# KIMI_PRICE_INPUT=
# KIMI_PRICE_OUTPUT=

# Development only: "replay" streams the stored desk-fan answers from fixtures/kimi with no model call.
# KIMI_PROVIDER=replay
